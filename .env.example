HYPER_API_KEY=your-hyper-api-key-here

# Optional sticky proxy (recommended for drops)
# HTTP_PROXY=http://user:pass@host:port

# Discord webhook for ATC / cart notifications (embed fallback)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Required for a normal Discord "Open Cart" button (not a link).
# Create a bot at https://discord.com/developers/applications → Bot → Reset Token.
# Invite it to your server with Send Messages permission in the alert channel.
DISCORD_BOT_TOKEN=
# Optional if DISCORD_WEBHOOK_URL is set (channel is resolved from the webhook).
# DISCORD_CHANNEL_ID=
